# ==============================================================================
# SOU Ride - Environment Configuration Example
# Silver Oak University (Ahmedabad, Gujarat)
# ==============================================================================

# Application Secret Key (Used for CSRF and Session Cookie Encryption)
# Generate a strong 64-character random key in production: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=sou_ride_purple_secret_development_key_change_in_production

# Database Configuration
# Local Development: SQLite
DATABASE_URL=sqlite:///database.db
# Production Deployment Example (PostgreSQL):
# DATABASE_URL=postgresql://sou_user:your_secure_password@localhost:5432/sou_ride_db

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# ==============================================================================
# EXTERNAL INTEGRATIONS (OPTIONAL - In-App Fallbacks Active by Default)
# ==============================================================================

# 1. MAPS & GEOCODING
# Default: OpenStreetMap & Leaflet.js (Free, no API key required, Ahmedabad presets)
# Optional Google Maps Platform / Mapbox integration:
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# 2. EMAIL NOTIFICATIONS (SMTP)
# Default: Real-time In-App Notifications stored in database.
# To enable external email dispatch to @silveroakuni.ac.in addresses:
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=campus.mobility@silveroakuni.ac.in
# SMTP_PASSWORD=your_app_specific_password
# MAIL_DEFAULT_SENDER=SOU Ride <campus.mobility@silveroakuni.ac.in>

# 3. SMS ALERTS (Twilio / Fast2SMS for Indian Mobile Numbers)
# Default: Mock / In-app alerts.
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# 4. CAMPUS VERIFICATION CONFIGURATION
# Institutional domain to auto-verify:
ALLOWED_UNIVERSITY_DOMAIN=@silveroakuni.ac.in
REQUIRE_STUDENT_ID_FORMAT=1
